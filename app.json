{
  "expo": {
    "name": "LendMate",
    "slug": "lendmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lendmate-icon.png",
    "scheme": ["lendmate", "com.googleusercontent.apps.1060609617260"],
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/lendmate-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/lendmate-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lendmate-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/lendmate-icon.png",
          "imageWidth": 230
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
