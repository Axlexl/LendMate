{
  "expo": {
    "name": "LendMate",
    "slug": "lendmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lendmate-icon.png",
    "scheme": [
      "lendmate",
      "com.googleusercontent.apps.1060609617260"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ph.lendmate.app",
      "icon": "./assets/images/lendmate-icon.png"
    },
    "android": {
      "package": "ph.lendmate.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "icon": "./assets/images/lendmate-icon.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/lendmate-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/lendmate-icon.png",
          "imageWidth": 230
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "200197bb-1532-49cf-b9b7-ddc2748e1182"
      }
    }
  }
}
